{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "situation.schema.json",
  "title": "Situation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "rating",
    "slots",
    "canvas",
    "mossPrompt",
    "animaPrompt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "string",
      "enum": [
        "safe",
        "sensitive",
        "explicit"
      ]
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outfits": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "mossPrompt": {
      "type": "string"
    },
    "animaPrompt": {
      "type": "string"
    },
    "negativeMoss": {
      "type": "string"
    },
    "negativeAnima": {
      "type": "string"
    }
  }
}