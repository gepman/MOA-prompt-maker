{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene.schema.json",
  "title": "Scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "situation",
    "cast"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "situation": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "cast": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "outfits": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "applyNegative": {
      "type": "boolean",
      "default": false
    },
    "gen": {
      "$ref": "#/$defs/gen"
    },
    "denoise": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "deprecated": true,
      "description": "v1.3 の旧キー。gen.anima.denoise を使う"
    },
    "compiled": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mossPrompt": {
          "type": "string"
        },
        "animaPrompt": {
          "type": "string"
        },
        "negativeApplied": {
          "type": "boolean"
        },
        "denoise": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "deprecated": true,
          "description": "v1.3 の旧キー。compiled.gen を使う"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gen": {
          "$ref": "#/$defs/gen"
        }
      }
    },
    "name": {
      "type": "string"
    }
  },
  "$defs": {
    "steps": {
      "type": "integer",
      "minimum": 1
    },
    "cfg": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "denoise": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gen": {
      "description": "生成パラメータ。書いた項目だけワークフローの値を上書きする（MOSS段に denoise はない）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "steps": {
              "$ref": "#/$defs/steps"
            },
            "cfg": {
              "$ref": "#/$defs/cfg"
            }
          }
        },
        "anima": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "steps": {
              "$ref": "#/$defs/steps"
            },
            "cfg": {
              "$ref": "#/$defs/cfg"
            },
            "denoise": {
              "$ref": "#/$defs/denoise"
            }
          }
        }
      }
    }
  }
}
